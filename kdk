.hero{border-top:10px solid var(--blue)}h1{font-size:27px;margin:4px 0 8px}h2{font-size:18px;margin:0 0 12px}.muted{color:var(--muted)}.pill{display:inline-block;background:#e8f0fe;color:#174ea6;border-radius:30px;padding:5px 10px;font-size:12px;margin:4px 5px 4px 0}
