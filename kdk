const weights = {
"Klien dan Keperawatan Holistik":10,
"Aspek Etik dan Legal":10,
"Kolaborasi Interprofesi (IPC)":30,
"Sistem Pelayanan Kesehatan":20,
"Standar Praktik Keperawatan Profesional":30
};
const labels={"Kasus":"Kasus","Penerapan":"Penerapan","Pendalaman":"Pendalaman","Standar":"Standar / konsep"};
let answers={},submitted=false;
function startQuiz(){
 document.getElementById('intro').classList.add('hidden');
 document.getElementById('quiz').classList.remove('hidden');
 const root=document.getElementById('questions');
 root.innerHTML=bank.map((q,i)=>`<article class="card" id="q${i}">
 <div class="qtop"><span>Soal ${i+1} dari 100</span><span>${q.subject} • ${labels[q.type]}</span></div>
 <p class="qtext">${q.q}</p>
 ${q.o.map((o,j)=>`<label class="option" id="opt${i}_${j}"><input type="radio" name="q${i}" value="${j}" onchange="choose(${i},${j})"><span>${String.fromCharCode(65+j)}. ${o}</span></label>`).join('')}
 </article>`).join('');
 updateProgress();window.scrollTo({top:0,behavior:'smooth'});
}
function choose(i,j){answers[i]=j;document.querySelectorAll(`[id^="opt${i}_"]`).forEach(x=>x.classList.remove('selected'));document.getElementById(`opt${i}_${j}`).classList.add('selected');updateProgress()}
function updateProgress(){let n=Object.keys(answers).length;document.getElementById('progress').textContent=`Terjawab ${n} / 100`}
function submitQuiz(){
 if(submitted)return;
 const unanswered=bank.length-Object.keys(answers).length;
 if(unanswered>0 && !confirm(`Masih ada ${unanswered} soal kosong. Tetap kumpulkan?`))return;
 submitted=true;
 let correct=0,wrong=0,blank=0,score=0,by={};
 Object.keys(weights).forEach(s=>by[s]={correct:0,wrong:0,blank:0,score:0,total:0});
 bank.forEach((q,i)=>{
  let b=by[q.subject];b.total++;
  if(answers[i]===undefined){blank++;b.blank++}
  else if(answers[i]===q.a){correct++;b.correct++;b.score+=weights[q.subject]/b.total /* replaced below */}
  else{wrong++;b.wrong++}
 });
 // Bobot per soal dibuat sama di dalam masing-masing materi
 Object.keys(by).forEach(s=>{
  const total=bank.filter(q=>q.subject===s).length;
  by[s].score=by[s].correct*(weights[s]/total);
  score+=by[s].score;
 });
 document.getElementById('score').textContent=score.toFixed(2).replace('.',',');
 document.getElementById('correct').textContent=correct;
 document.getElementById('wrong').textContent=wrong;
 document.getElementById('blank').textContent=blank;
 document.getElementById('message').textContent=score>=85?'Sangat baik!':score>=70?'Baik, terus tingkatkan pemahaman.':score>=55?'Cukup. Pelajari kembali bagian yang belum dikuasai.':'Perlu belajar ulang dan mencoba kembali.';
 document.getElementById('subjectResults').innerHTML=`<table class="table"><thead><tr><th>Materi</th><th>Benar</th><th>Salah</th><th>Kosong</th><th>Nilai berbobot</th></tr></thead><tbody>${Object.keys(by).map(s=>`<tr><td>${s} (${weights[s]}%)</td><td>${by[s].correct}</td><td>${by[s].wrong}</td><td>${by[s].blank}</td><td>${by[s].score.toFixed(2)}</td></tr>`).join('')}</tbody></table>`;
 document.getElementById('quiz').classList.add('hidden');document.getElementById('result').style.display='block';
 window.scrollTo({top:0,behavior:'smooth'});
}
function showReview(){
 const root=document.getElementById('reviewList');
 root.innerHTML=bank.map((q,i)=>{
  let a=answers[i],ok=a===q.a,cls=a===undefined?'blank':ok?'correct':'wrong';
  let status=a===undefined?'Belum dijawab':ok?'Benar':'Salah';
  return `<article class="card"><div class="qtop"><span>Soal ${i+1}</span><span>${q.subject} • ${labels[q.type]}</span></div><p class="qtext">${q.q}</p>
  <div class="feedback ${cls}"><b>${status}.</b> ${a===undefined?'Tidak ada jawaban yang dipilih.':`Jawaban Anda: ${String.fromCharCode(65+a)}. ${q.o[a]}`}</div>
  <p><b>Kunci jawaban:</b> ${String.fromCharCode(65+q.a)}. ${q.o[q.a]}</p><p class="muted"><b>Pembahasan:</b> ${q.e}</p></article>`;
 }).join('');
 document.getElementById('result').style.display='none';document.getElementById('review').classList.remove('hidden');window.scrollTo({top:0,behavior:'smooth'});
}
